generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Memory {
  id          String   @id @default(cuid())
  imageUrl    String
  story       String
  
  // AI-generated content
  title       String?  @default("Untitled Memory")
  description String?
  
  // AI-extracted insights (stored as JSON strings for SQLite)
  emotions    String?
  people      String?
  themes      String?
  locations   String?
  events      String?

  // Search and discovery
  embedding   String?
  keywords    String?
  
  createdAt   DateTime @default(now())
  
  @@index([createdAt])
}
